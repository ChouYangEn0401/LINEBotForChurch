# ============================================================
# 機密設定（這個檔案複製成 .env 後再填，.env 不會被上傳到 git）
# ============================================================

# LINE Developers → 你的 Messaging API Channel → Messaging API 分頁 → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers → 你的 Channel → Basic settings 分頁 → Channel secret
# （只有要用「在群組打 ID 自動抓群組」功能時才需要）
LINE_CHANNEL_SECRET=

# 網站密碼（第一層）：進得了網站 = 看得到首頁、可以新增牧區；進牧區還要那個牧區的密碼
# 留空 = 不用密碼，只限本機電腦能開
UI_PASSWORD=

# ---- 伺服器管理員（server_manager）：所有牧區、全教會設定都能管，牧區密碼對他無效 ----
# 建議在網頁「全教會設定 → 伺服器管理員」設定，不用手動填。
# 管理者密碼（至少 10 個字）。在執行機器人的那台電腦上只要這個；從外面還要下面任一個
SERVER_MANAGER_PASSWORD=
# 驗證器 App（Google Authenticator 這類）的金鑰（Base32）；在網頁上掃 QR code 設定
SERVER_MANAGER_TOTP_SECRET=
# Telegram 登入碼：機器人的 token、你自己的 Telegram 數字 ID（問 @userinfobot 就知道）
# 只用在「從外面登入伺服器管理員時的一次性驗證碼」。沒填 = 改用驗證器 App，其他一切照常。
# 狀態播報（後台開了／關了／當掉、每次發送的彙總）不走這裡，走下面的 Notifier_TB。
TELEGRAM_BOT_TOKEN=
SERVER_MANAGER_TELEGRAM_ID=

# ---- 狀態播報：交給這台電腦上的 Notifier_TB ----
# 後台開了／關了／意外停掉、每次發送的彙總，都往 Notifier_TB 的 socket 丟一個封包就結束
# （不連 Telegram、不輪詢；token 和收件人都是 Notifier 的事，這個專案一個金鑰都不用保管）。
# 預設自己去隔壁找 ../Notifier_TB/config.json，所以通常這兩行都不用填：
#   Notifier_TB 放在別的地方 → 填它的資料夾
NOTIFIER_TB_HOME=
#   完全不想接 → 填 1，播報就安靜地不做事
NOTIFIER_DISABLED=
