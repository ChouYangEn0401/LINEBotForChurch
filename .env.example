# ============================================================
# 機密設定（這個檔案複製成 .env 後再填，.env 不會被上傳到 git）
# ============================================================

# LINE Developers → 你的 Messaging API Channel → Messaging API 分頁 → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers → 你的 Channel → Basic settings 分頁 → Channel secret
# （只有要用「在群組打 ID 自動抓群組」功能時才需要）
LINE_CHANNEL_SECRET=

# 網頁管理介面的密碼（留空 = 不用密碼，只限本機電腦能開）
UI_PASSWORD=
