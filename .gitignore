# ---- 機密與教會資料（絕對不要上傳）----
.env
config/settings.yaml
# 群組表、同工名單、組織架構、範例服事表…所有 CSV 都是教會自己的資料；只有 *.example.* 範例檔會上傳
config/*.csv
config/*.json
!config/*.example.*
# 多牧區：牧區清單（含牧區密碼的雜湊）、每個牧區的資料夾、升級前的舊檔、移除的牧區
config/church.yaml
config/ministries/
config/_before_ministries/
config/_deleted/
credentials*.json
service-account*.json

# ---- 執行時產生 ----
data/*
!data/.gitkeep
*.log

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ---- 編輯器 / 系統 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Windows 服務用的小工具 ----
# nssm.exe：install.bat 會自己用 winget 抓一份放進來（見 scripts/windows/service/service.ps1）。
# 公有領域的現成執行檔，不進 git；換電腦時那邊自己抓就好。
tools/
# 服務模式下程式畫面上的訊息（nssm 幫忙寫的，會自動輪替）
data/service.log
data/service.log.*
data/notify_outbox.jsonl
